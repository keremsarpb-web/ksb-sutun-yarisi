rules_version = '2';

// Sütun Yarışı (tarayıcı sürümü) Firestore güvenlik kuralları.
// Firebase konsolu > Firestore Database > Rules sekmesinde yayınlıdır.
service cloud.firestore {
  match /databases/{database}/documents {
    // Oyuncunun kaydı (coin, kutu, kozmetik, sınavlar): yalnızca sahibi
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Sıralama: herkes görür, herkes yalnızca kendi satırını yazar
    match /public/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'role', 'className', 'color', 'shape', 'eyes', 'mouth', 'hat', 'aura', 'wins', 'games', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 30
        && request.resource.data.wins is int && request.resource.data.games is int;
    }
    // Sınıflar: öğrenciler sınıfın varlığını görür; bir kez açılır, sonra değişmez
    match /classes/{key} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['name', 'uid']);
      allow update, delete: if false;
    }
  }
}
