rules_version = '2';

// Sütun Yarışı (tarayıcı sürümü) Firestore güvenlik kuralları.
// Firebase konsolu > Firestore Database > Rules sekmesinde yayınlıdır.
service cloud.firestore {
  match /databases/{database}/documents {
    // Admin: "kerem" kullanıcı adlı öğrenci hesabı
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'ogr.kerem@sutunyarisi.example.com';
    }
    // Oyuncunun kaydı (coin, kutu, kozmetik, sınavlar): yalnızca sahibi.
    // Admin herkesi görebilir ama yalnızca hediye coin (giftCoins) bırakabilir.
    match /users/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      allow write: if request.auth != null && request.auth.uid == uid;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['giftCoins'])
        && request.resource.data.giftCoins is int && request.resource.data.giftCoins <= 10000000;
    }
    // Sıralama: herkes görür, herkes yalnızca kendi satırını yazar
    match /public/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'role', 'className', 'color', 'shape', 'eyes', 'mouth', 'hat', 'aura', 'wins', 'games', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 30
        && request.resource.data.wins is int && request.resource.data.games is int;
    }
    // Sınıflar: öğrenciler sınıfın varlığını görür; bir kez açılır, sonra değişmez
    match /classes/{key} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['name', 'uid']);
      allow update, delete: if false;
    }
  }
}
