rules_version = '2';

// Sütun Yarışı (tarayıcı sürümü) Firestore güvenlik kuralları.
// Firebase konsolu > Firestore Database > Rules sekmesinde yayınlıdır.
service cloud.firestore {
  match /databases/{database}/documents {
    // Admin: "kerem" kullanıcı adlı öğrenci hesabı
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'ogr.kerem@sutunyarisi.example.com';
    }
    // Oyuncunun kaydı (coin, kutu, kozmetik, sınavlar): yalnızca sahibi.
    // Admin herkesi görebilir ama yalnızca hediye coin (giftCoins) bırakabilir.
    match /users/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      allow write: if request.auth != null && request.auth.uid == uid;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['giftCoins'])
        && request.resource.data.giftCoins is int && request.resource.data.giftCoins <= 10000000;
    }
    // Sıralama: herkes görür, herkes yalnızca kendi satırını yazar
    match /public/{uid} {
      allow read: if true;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'role', 'className', 'color', 'shape', 'eyes', 'mouth', 'hat', 'aura', 'wins', 'games', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 30
        && request.resource.data.wins is int && request.resource.data.games is int;
    }
    // Köyüm (ortak dünya): herkes bütün köyleri görür, herkes yalnızca kendi köyünü yazar
    match /world/{uid} {
      allow read: if true;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'className', 'look', 'plot', 'tiles', 'pos', 'lastSeen', 'updatedAt'])
        && request.resource.data.plot is int && request.resource.data.plot >= 0 && request.resource.data.plot < 100000
        && request.resource.data.tiles is map && request.resource.data.tiles.size() <= 64
        && request.resource.data.name is string && request.resource.data.name.size() <= 30;
    }
    // Arsa sayacı: her yeni köy için birer artar
    match /worldMeta/plots {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.next == 1;
      allow update: if request.auth != null && request.resource.data.next == resource.data.next + 1;
    }
    // Sınıflar: öğrenciler sınıfın varlığını görür; bir kez açılır, sonra değişmez
    match /classes/{key} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['name', 'uid']);
      allow update: if false;
      // Sınıf hesabı silinince sınıf kaydı da silinir
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
    // Şikayetler: giriş yapan herkes bildirebilir; yalnızca proje sahibi (konsoldan) okur
    match /reports/{id} {
      allow create: if request.auth != null && request.resource.data.by == request.auth.uid
        && request.resource.data.keys().hasOnly(['by', 'target', 'name', 'reason', 'at'])
        && request.resource.data.reason is string && request.resource.data.reason.size() <= 200;
      allow read, update, delete: if false;
    }
  }
}
